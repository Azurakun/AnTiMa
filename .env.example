# --- Required ---
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"
# Not needed with docker-compose (it points the bot at the bundled MongoDB).
MONGO_URI="mongodb://localhost:27017/antima_db"

# --- Web dashboard ---
# Password for the admin dashboard at "/". If unset, the admin pages are disabled
# (web chat and web RPG still work).
DASHBOARD_PASSWORD="CHOOSE_A_LONG_RANDOM_PASSWORD"
# Signs login and web-player cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY="YOUR_RANDOM_SECRET_HERE"
# Public URL of the dashboard, used in links the bot sends (e.g. /rpg web_new)
WEB_DASHBOARD_URL="http://localhost:8000"

# --- AI ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# AI Provider: "gemini", "ollama", "groq", "openrouter", or "deepseek"
AI_PROVIDER="gemini"

# Optional API keys for alternative providers
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"

# Optional: Override model names (defaults depend on provider)
# AI_MAIN_MODEL="gemini-2.5-flash"
# AI_FAST_MODEL="gemini-2.5-flash-lite"
# AI_MAIN_MODEL="qwen3:1.7b"
# AI_FAST_MODEL="qwen3:1.7b"
# AI_MAIN_MODEL="llama-3.3-70b-versatile"
# AI_FAST_MODEL="llama-3.1-8b-instant"
# AI_MAIN_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# AI_FAST_MODEL="meta-llama/llama-3.1-8b-instruct:free"
# AI_MAIN_MODEL="deepseek-chat"
# AI_FAST_MODEL="deepseek-chat"

# Optional: embedding model for memory search (Gemini API). Default: gemini-embedding-001.
# Changing it is safe: old memories are re-embedded the next time they are searched.
# EMBED_MODEL="gemini-embedding-001"
# Optional: OpenAI embeddings are used if Gemini is unavailable.
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# --- Optional integrations ---
TENOR_API_KEY="YOUR_TENOR_API_KEY_HERE"
# GOOGLE_SEARCH_API_KEY=""
# GOOGLE_SEARCH_ENGINE_ID=""
